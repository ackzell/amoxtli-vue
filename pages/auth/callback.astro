<html>
  <head><title>Auth callback</title></head>
  <body>
    <h1>Finishing login...</h1>
    <p id="msg">Please wait...</p>

    <script type="module">
      import { createClient } from '@supabase/supabase-js';

      const supabase = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );

      (async () => {
        try {
          const {
            data: { session },
            error,
          } = await supabase.auth.getSession();

          if (error) {
            console.error('Supabase getSession error:', error);
            document.getElementById('msg').textContent = 'Authentication error';
            return;
          }

          if (session?.access_token) {
            const res = await fetch('/.netlify/functions/set-cookie', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'include',
              body: JSON.stringify({ token: session.access_token }),
            });

            if (!res.ok) {
              console.error('Failed to set cookie:', await res.text());
              document.getElementById('msg').textContent = 'Server error';
              return;
            }

            // remove token from URL/hash and redirect to app
            history.replaceState(null, '', window.location.pathname);
            window.location.replace('/');
          } else {
            console.warn('No session found in callback');
            document.getElementById('msg').textContent = 'No session found';
          }
        } catch (err) {
          console.error(err);
          document.getElementById('msg').textContent = 'Unexpected error';
        }
      })();
    </script>
  </body>
</html>
