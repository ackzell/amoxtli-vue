---
import { supabaseClient } from '@lib/supabase';
import ExpandPreviewButton from './ExpandPreviewButton.vue';
import LogoutButton from './LogoutButton.vue';
import UserProfileMenu from './UserProfileMenu.vue';
import LayoutToggle from './LayoutToggle.vue';
---

<script>
  document.addEventListener('astro:after-swap', () => {
    console.log('astro:after-swap event fired in TopBar');

    const root = document.documentElement;

    const theme = root.dataset.theme;

    if (theme) {
      root.classList.add('theme-ready');
    }
  });
</script>

<nav>
  <div
    class="flex items-center justify-between h-auto max-w-full p-2 sm:h-full border-b border-tk-elements-app-borderColor bg-tk-elements-topBar-backgroundColor transition-theme"
  >
    <div class="flex-1 ml-2">
      <div
        class="text-primary dark:text-primary-dark font-mono text-xl font-bold"
      >
        Amoxtli Vue
      </div>
      <div class="text-[var(--tk-text-primary)]/50 text-xs">
        A book about Vue
      </div>
    </div>

    <div
      class="items-center justify-center flex-3 hidden h-full sm:flex w-55% z-10"
    >
      <slot name="nav-bar" />
    </div>

    <div class="flex items-center justify-end flex-1 gap-1">
      <LayoutToggle client:only="Vue" />
      <slot name="theme-switch" />

      <UserProfileMenu client:only="vue" />
    </div>
  </div>
  <div
    class="flex items-center justify-center mt-4 mb-8 sm:hidden mr-9 relative z-10"
  >
    <div class="items-center justify-center w-full h-full flex-3">
      <slot name="nav-bar" />
    </div>
  </div>
</nav>
