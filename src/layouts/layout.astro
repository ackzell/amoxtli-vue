---
import ThemeSwitcher from '@components/ThemeSwitcher.vue';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <style>
      @property --hdr-color-1 {
        syntax: '<color>';
        inherits: false;
        initial-value: oklch(0 0 0);
      }
      @property --hdr-color-2 {
        syntax: '<color>';
        inherits: false;
        initial-value: oklch(0 0 0);
      }
      @property --hdr-color-3 {
        syntax: '<color>';
        inherits: false;
        initial-value: oklch(0 0 0);
      }
      @property --hdr-x {
        syntax: '<percentage>';
        inherits: false;
        initial-value: 50%;
      }
      @property --hdr-y {
        syntax: '<percentage>';
        inherits: false;
        initial-value: 50%;
      }

      :root {
        transition:
          --hdr-color-1 1s ease,
          --hdr-color-2 1s ease,
          --hdr-color-3 1s ease,
          --hdr-x 1s ease,
          --hdr-y 1s ease;

        /* Intermediate animatable version */
        background: radial-gradient(
          farthest-corner circle at var(--hdr-x) var(--hdr-y) in oklch,
          var(--hdr-color-1) 12%,
          var(--hdr-color-2) 14%,
          var(--hdr-color-3) 51%
        );
        position: relative;
        overflow: hidden;
      }

      /* These pseudo-elements hold your “true” gradients */
      :root::after {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -1;
        opacity: 0;
        transition: opacity 0.6s ease;
        pointer-events: none;
        background: var(--hdr-gradient-final);
      }

      /* --- LIGHT THEME --- */
      :root[data-theme='light'] {
        --amv-highlight: oklch(0.77 0.14 70.23);
        --tk-text-primary: oklch(40% 0.05 249);

        --hdr-color-1: var(--amv-highlight);
        --hdr-color-2: oklch(0.9702 0 0);
        --hdr-color-3: oklch(0.9702 0 0);
        --hdr-x: 50%;
        --hdr-y: -15%;

        /* Your true gradient */
        --hdr-gradient-final: radial-gradient(
          farthest-corner circle at 50% -19% in oklch decreasing hue,
          var(--amv-highlight) 12%,
          14%,
          oklch(0.9702 0 0) 51%
        );
      }

      /* --- DARK THEME --- */
      :root[data-theme='dark'] {
        --amv-highlight: oklch(0.77 0.14 70.23);
        --tk-text-primary: oklch(0.8385 0.0263 248.14);

        --hdr-color-1: oklch(60% 0.224 354);
        --hdr-color-2: oklch(60% 0.224 354);
        --hdr-color-3: oklch(15% 0.1 110);
        --hdr-x: 0%;
        --hdr-y: 115%;

        /* Your true gradient */
        --hdr-gradient-final: radial-gradient(
          farthest-corner circle at 0% 115% in oklch increasing hue,
          oklch(60% 0.224 354) 12%,
          14%,
          oklch(15% 0.1 110) 51%
        );
      }

      /* --- When animation finishes, fade in the real gradient --- */
      :root[data-theme='dark'].theme-ready::after,
      :root[data-theme='light'].theme-ready::after {
        opacity: 1;
      }

      body {
        color: var(--tk-text-primary);
        transition: color 0.4s ease;
      }
    </style>

    <script>
      const root = document.documentElement;

      // 1️⃣ On first load, immediately set `theme-ready`
      const theme = root.dataset.theme;
      if (theme) {
        root.classList.add('theme-ready');
      }

      // 2️⃣ Observe when the theme changes (ThemeSwitcher updates data-theme)
      const observer = new MutationObserver((mutations) => {
        for (const m of mutations) {
          if (m.type === 'attributes' && m.attributeName === 'data-theme') {
            // Trigger the transition by removing and re-adding `.theme-ready`
            root.classList.remove('theme-ready');
            requestAnimationFrame(() => {
              setTimeout(() => root.classList.add('theme-ready'), 900);
            });
          }
        }
      });

      observer.observe(root, { attributes: true });
    </script>
  </head>

  <body
    class="text-[whitesmoke]
    min-h-dvh
    flex flex-col items-center justify-center gap-4
    font-sans antialiased"
  >
    <div class="position-fixed top-4 right-4">
      <ThemeSwitcher client:load />
    </div>
    <slot />
  </body>
</html>
